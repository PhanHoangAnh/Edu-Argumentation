# Template for /home/ubuntu/foxai-data/edu-argumentation/provider.env
# Owner ubuntu:ubuntu, mode 600. Never commit the real file.
#
# You do NOT need to hand-edit this in normal use: the in-app Settings page
# writes these values and applies them to the running service without a restart.
# EDU_ADMIN_TOKEN is the exception -- it is the key to that page, so it is set
# once here, on the box.

# OpenAI-compatible Chat Completions endpoint. https://, or http:// on localhost.
EDU_QUIZ_API_URL=
EDU_QUIZ_API_KEY=
EDU_QUIZ_MODEL=
# Optional. Blank means generation is not gated; see the Settings page toggle.
EDU_QUIZ_ACCESS_TOKEN=
# Set false only for a provider that rejects response_format=json_object.
EDU_QUIZ_JSON_MODE=true
# Unlocks the Settings page. No value here = settings are locked for everyone.
EDU_ADMIN_TOKEN=
